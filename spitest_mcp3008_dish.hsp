#include "hsp3dish.as"
#include "./mcp3008.as"

onexit *exiterr

fdch = 0
bus_idx = 0
chip_select = 0
devcontrol "spiopen", bus_idx, chip_select, fdch
if stat {
	goto *exiterr
}

*main
	analog = adcgetbybyte(0, fdch)
	if analog < 0 {
		goto *exiterr
	}
	wait 50
	analog2 = adcget(0, fdch)
	if analog2 < 0 {
		goto *exiterr
	}
	wait 50
	redraw 0
	pos 0, 0
	mes "voltage: " + analog + " " + analog2
	redraw 1
	goto *main

*exiterr
	devcontrol "spiclose", adc_spich
	end
